-- Biến chức năng toàn cục
_G.BringFarm = false       
_G.TeleportFarm = false    
_G.AutoSkillV51 = false    
_G.RetroAnimV51 = false    
_G.AutoRespawn = false     
local Offset_X = 30  
local OriginalPositions = {}

-- Hàm tạo Toggle Button trong Tab
local function CreateToggleUI(parent, name, callback, posY)
    local toggleBtn = Instance.new("TextButton")
    toggleBtn.Size = UDim2.new(1, -20, 0, 35)
    toggleBtn.Position = UDim2.new(0, 10, 0, posY)
    toggleBtn.BackgroundColor3 = Color3.fromRGB(35, 48, 75)
    toggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    toggleBtn.Text = name .. ": [OFF]"
    toggleBtn.TextSize = 13
    toggleBtn.Font = Enum.Font.Gotham
    toggleBtn.Parent = parent

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = toggleBtn

    local state = false
    toggleBtn.MouseButton1Click:Connect(function()
        state = not state
        if state then
            toggleBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 255)
            toggleBtn.Text = name .. ": [ON]"
        else
            toggleBtn.BackgroundColor3 = Color3.fromRGB(35, 48, 75)
            toggleBtn.Text = name .. ": [OFF]"
        end
        callback(state)
    end)
end

-- Thêm các chức năng vào Tab
CreateToggleUI(Tab1, "Bring Enemies", function(v) _G.BringFarm = v end, 10)
CreateToggleUI(Tab1, "Teleport to Enemies", function(v) _G.TeleportFarm = v end, 55)
CreateToggleUI(Tab1, "Auto Skill (Right Click)", function(v) _G.AutoSkillV51 = v end, 100)

CreateToggleUI(Tab2, "Retro Animation V51", function(v) _G.RetroAnimV51 = v end, 10)

CreateToggleUI(Tab3, "Auto Respawn / Bypass", function(v) _G.AutoRespawn = v end, 10)

-- 3. CÁC HÀM XỬ LÝ LOGIC CHÍNH
local function hasRedColor(model)
    for _, child in pairs(model:GetDescendants()) do
        if child:IsA("BrickColorValue") or child:IsA("Color3Value") then
            if tostring(child.Value):lower():find("red") then return true end
        end
    end
    return false
end

local function processAndCheckTarget(model)
    if not model:IsA("Model") or model == LP.Character then return false end
    local rootPart = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso") or model:FindFirstChildOfClass("Part")
    if not rootPart then return false end

    local nameLower = model.Name:lower()
    if nameLower:find("blue") or nameLower:find("base") then return false end
    
    local isBoss = nameLower:find("boss")
    local isRedEnemy = hasRedColor(model) or nameLower:find("red")
    local isIdentifiedEnemy = nameLower:find("redteam") or nameLower:find("enemy") or nameLower:find("zombie")

    if not nameLower:find("battler") and not isBoss and not isRedEnemy and not isIdentifiedEnemy then return false end

    if not OriginalPositions[model] then OriginalPositions[model] = rootPart.CFrame end
    if model.Name ~= "Zombie" then model.Name = "Zombie" end

    local humanoid = model:FindFirstChildOfClass("Humanoid")
    return humanoid and humanoid.Health > 0
end

-- Hệ thống tự động hồi sinh qua CoreGui
task.spawn(function()
    while true do
        task.wait(0.4)
        if _G.AutoRespawn then
            pcall(function()
                local char = LP.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                
                if not char or (hum and hum.Health <= 0) or not char:FindFirstChild("HumanoidRootPart") then
                    local robloxGui = CoreGui:FindFirstChild("RobloxGui")
                    local inGameMenu = robloxGui and robloxGui:FindFirstChild("InGameMenu", true)
                    
                    if inGameMenu then
                        local container = inGameMenu:FindFirstChild("RespawnDialogContainer", true)
                        if container then
                            for _, btn in pairs(container:GetDescendants()) do
                                if btn:IsA("TextButton") then
                                    local txt = btn.Text:lower()
                                    if txt:find("có") or txt:find("yes") or txt:find("respawn") or txt:find("xuất hiện") then
                                        firesignal(btn.MouseButton1Click)
                                    end
                                end
                            end
                        end
                    end
                    
                    if LP:FindFirstChild("CharacterAppearanceId") then
                        LP:LoadCharacter()
                    end
                    
                    LP.CharacterAdded:Wait()
                    task.wait(0.5)
                end
            end)
        end
    end
end)

-- Vòng lặp xử lý Farm (Bring / Teleport)
RunService.Heartbeat:Connect(function()
    local MyCharacter = LP.Character
    local MyRoot = MyCharacter and MyCharacter:FindFirstChild("HumanoidRootPart")
    if not MyRoot then return end

    if _G.BringFarm then
        local CenterPosition = (MyRoot.CFrame * CFrame.new(0, 0, -3)).Position
        local count = 0
        for _, obj in pairs(workspace:GetDescendants()) do
            if processAndCheckTarget(obj) then
                local EnemyRoot = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso")
                if EnemyRoot then
                    count = count + 1
                    local angle = count * (math.pi * 2 / 8)
                    EnemyRoot.CFrame = CFrame.new(CenterPosition + Vector3.new(math.cos(angle)*1.5, 0, math.sin(angle)*1.5), MyRoot.Position)
                end
            end
        end
    elseif _G.TeleportFarm then
        for _, obj in pairs(workspace:GetDescendants()) do
            if processAndCheckTarget(obj) then
                local EnemyRoot = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso")
                if EnemyRoot then
                    MyRoot.CFrame = CFrame.new(EnemyRoot.Position + Vector3.new(0, 0, 2), EnemyRoot.Position)
                    break
                end
            end
        end
    end
end)

-- Vòng lặp đánh quái và kích hoạt skill
task.spawn(function()
    while true do
        task.wait(0.05)
        if _G.BringFarm or _G.TeleportFarm then
            local MyCharacter = LP.Character
            local MyHumanoid = MyCharacter and MyCharacter:FindFirstChildOfClass("Humanoid")
            if MyHumanoid and MyHumanoid.Health > 0 then
                local Tool = LP.Backpack:FindFirstChildOfClass("Tool")
                if Tool then MyHumanoid:EquipTool(Tool) end
                
                local EquippedTool = MyCharacter:FindFirstChildOfClass("Tool")
                if EquippedTool then
                    EquippedTool:Activate()
                    local cam = workspace.CurrentCamera
                    local cx, cy = cam.ViewportSize.X / 2 + Offset_X, cam.ViewportSize.Y / 2
                    
                    VIM:SendMouseButtonEvent(cx, cy, 0, true, game, 1)
                    task.wait(0.01)
                    VIM:SendMouseButtonEvent(cx, cy, 0, false, game, 1)
                    
                    if _G.AutoSkillV51 then
                        VIM:SendMouseButtonEvent(cx, cy, 1, true, game, 1)
                        task.wait(0.01)
                        VIM:SendMouseButtonEvent(cx, cy, 1, false, game, 1)
                    end
                end
            end
        end
    end
end)
