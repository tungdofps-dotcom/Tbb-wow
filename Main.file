-- 2. HỆ THỐNG SIDEBAR BÊN TRÁI (CHUYỂN ĐỔI TAB)
local Sidebar = Instance.new("Frame")
Sidebar.Size = UDim2.new(0, 130, 1, -40)
Sidebar.Position = UDim2.new(0, 0, 0, 40)
Sidebar.BackgroundColor3 = Color3.fromRGB(20, 28, 45)
Sidebar.BorderSizePixel = 0
Sidebar.Parent = MainFrame

local function CreateTabPage()
    local page = Instance.new("ScrollingFrame")
    page.Size = UDim2.new(1, -140, 1, -50)
    page.Position = UDim2.new(0, 140, 0, 50)
    page.BackgroundTransparency = 1
    page.Visible = false
    page.CanvasSize = UDim2.new(0, 0, 1.5, 0)
    page.ScrollBarThickness = 4
    page.Parent = MainFrame
    return page
end

local Tab1 = CreateTabPage()
local Tab2 = CreateTabPage()
local Tab3 = CreateTabPage()
Tab1.Visible = true

local function CreateSidebarButton(name, posY, targetTab, btnList)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -10, 0, 35)
    btn.Position = UDim2.new(0, 5, 0, posY)
    btn.BackgroundColor3 = Color3.fromRGB(30, 40, 60)
    btn.TextColor3 = Color3.fromRGB(200, 200, 200)
    btn.Text = name
    btn.TextSize = 14
    btn.Font = Enum.Font.GothamSemibold
    btn.Parent = Sidebar

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn

    btn.MouseButton1Click:Connect(function()
        Tab1.Visible = false
        Tab2.Visible = false
        Tab3.Visible = false
        targetTab.Visible = true
        
        -- Reset màu các nút sidebar về tối, nút đang chọn đổi sang xanh sáng
        for _, otherBtn in ipairs(btnList) do
            otherBtn.BackgroundColor3 = Color3.fromRGB(30, 40, 60)
            otherBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
        end
        btn.BackgroundColor3 = Color3.fromRGB(0, 120, 255)
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    end)
    return btn
end

local buttons = {}
local b1 = CreateSidebarButton("Main Farm", 10, Tab1, buttons)
local b2 = CreateSidebarButton("Animations", 55, Tab2, buttons)
local b3 = CreateSidebarButton("Settings", 100, Tab3, buttons)
table.insert(buttons, b1)
table.insert(buttons, b2)
table.insert(buttons, b3)

